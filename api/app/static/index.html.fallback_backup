      name: st.name,
      domain: st.domain || 'Innovation & Technology',
      solution_title: st.solution_title || 'GeM Catalog Solution',
      description: st.description || '',
      trl_level: st.trl_level || 7,
      gem_seller_id: st.gem_seller_id || '',
      state: st.state || 'India (GeM Verified)',
      gem_url: st.gem_url || ''
