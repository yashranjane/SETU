<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SETU &mdash; GFR 2017 Rule 173 Innovation Sandbox Portal | Government of India</title>
<style>
:root{
  --navy:#003366;--blue:#0066CC;--saffron:#FF6200;--green:#138808;
  --light:#F5F5F5;--mid:#E8E8E8;--border:#CCCCCC;--text:#212121;--muted:#666;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:Arial,Helvetica,sans-serif;font-size:14px;color:var(--text);background:var(--light);min-height:100vh;display:flex;flex-direction:column;}
a{color:var(--blue);text-decoration:none;}
/* TOP STRIP */
.top-strip{background:#1a1a1a;color:#bbb;font-size:11px;padding:4px 16px;display:flex;justify-content:space-between;align-items:center;}
/* HEADER */
.gov-header{background:var(--navy);color:#fff;padding:10px 16px;display:flex;align-items:center;gap:16px;}
.gov-emblem{width:50px;height:50px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0;}
.gov-name-en{font-size:17px;font-weight:bold;letter-spacing:.5px;}
.gov-name-hi{font-size:12px;color:#aac4ff;margin-top:1px;}
.gov-tagline{font-size:11px;color:#8ab4f8;margin-top:2px;}
.gov-header-right{margin-left:auto;text-align:right;font-size:12px;color:#aac4ff;}
/* TRICOLOR */
.tricolor{height:6px;background:linear-gradient(90deg,#FF9933 33%,#fff 33% 66%,#138808 66%);}
/* NAV */
.gov-nav{background:#004C97;display:flex;align-items:stretch;padding:0 8px;flex-wrap:wrap;}
.nav-btn{color:#fff;font-size:13px;padding:9px 14px;cursor:pointer;background:none;border:none;border-bottom:3px solid transparent;white-space:nowrap;}
.nav-btn:hover,.nav-btn.active{background:rgba(255,255,255,.12);border-bottom-color:#FF9933;}
.nav-spacer{flex:1;}
.nav-user-info{color:#c8dcff;font-size:12px;padding:9px 14px;display:flex;align-items:center;gap:8px;}
/* MAIN CONTAINER */
.main{flex:1;padding:20px 16px;max-width:1120px;margin:0 auto;width:100%;}
.page{display:none;}.page.active{display:block;}
/* CARDS */
.card{background:#fff;border:1px solid var(--border);margin-bottom:18px;border-radius:3px;box-shadow:0 1px 3px rgba(0,0,0,.05);}
.card-header{background:var(--navy);color:#fff;padding:10px 14px;font-size:13px;font-weight:bold;display:flex;justify-content:space-between;align-items:center;border-radius:3px 3px 0 0;}
.card-body{padding:16px;}
/* TABLES */
.data-table{width:100%;border-collapse:collapse;font-size:13px;}
.data-table th{background:var(--navy);color:#fff;padding:9px 12px;text-align:left;font-weight:normal;font-size:12px;}
.data-table td{padding:9px 12px;border-bottom:1px solid #EBEBEB;vertical-align:middle;}
.data-table tr:hover td{background:#EEF4FF;cursor:pointer;}
.data-table tr:nth-child(even) td{background:#FAFAFA;}
/* FORMS */
.form-group{margin-bottom:14px;}
.form-label{display:block;font-size:11px;color:#555;text-transform:uppercase;letter-spacing:.5px;margin-bottom:5px;font-weight:bold;}
.form-control{width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:3px;font-size:13.5px;outline:none;}
.form-control:focus{border-color:var(--blue);box-shadow:0 0 0 2px rgba(0,102,204,.15);}
select.form-control{cursor:pointer;background:#fff;}
textarea.form-control{resize:vertical;min-height:80px;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;font-size:13px;font-weight:bold;border:none;border-radius:3px;cursor:pointer;transition:opacity .15s;white-space:nowrap;}
.btn:hover{opacity:.88;}.btn:disabled{opacity:.5;cursor:not-allowed;}
.btn-primary{background:#0066CC;color:#fff;}
.btn-success{background:#2E7D32;color:#fff;}
.btn-danger{background:#C62828;color:#fff;}
.btn-warning{background:#E65100;color:#fff;}
.btn-secondary{background:#546E7A;color:#fff;}
.btn-outline{background:#fff;color:var(--navy);border:1px solid var(--navy);}
.btn-sm{padding:5px 12px;font-size:12px;}
.btn-xs{padding:3px 8px;font-size:11px;}
/* BADGES & CHIPS */
.badge{display:inline-block;padding:3px 8px;border-radius:10px;font-size:11px;font-weight:bold;text-transform:uppercase;}
.badge-open{background:#E8F5E9;color:#2E7D32;border:1px solid #A5D6A7;}
.badge-matched{background:#E3F2FD;color:#1565C0;border:1px solid #90CAF9;}
.badge-pilotactive{background:#FFF3E0;color:#E65100;border:1px solid #FFCC80;}
.badge-scaleuprecommended{background:#F3E5F5;color:#6A1B9A;border:1px solid #CE93D8;}
.badge-approved{background:#E8F5E9;color:#2E7D32;border:1px solid #A5D6A7;}
.badge-pending{background:#FFF8E1;color:#F57F17;border:1px solid #FFE082;}
.badge-proofsubmitted{background:#E1F5FE;color:#0277BD;border:1px solid #81D4FA;}
.chip{display:inline-block;background:#EEF4FF;color:#003366;border:1px solid #C8D8FF;padding:2px 8px;border-radius:12px;font-size:11px;font-weight:bold;margin-right:4px;margin-bottom:4px;}
.chip-green{background:#E8F5E9;color:#2E7D32;border-color:#A5D6A7;}
.chip-purple{background:#F3E5F5;color:#7B1FA2;border-color:#CE93D8;}
/* STATS */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:20px;}
.stat-card{background:#fff;border:1px solid var(--border);border-left:4px solid var(--blue);padding:14px;border-radius:2px;}
.stat-n{font-size:26px;font-weight:bold;color:var(--navy);}
.stat-l{font-size:11px;color:var(--muted);text-transform:uppercase;margin-top:3px;}
/* ALERTS */
.alert{padding:10px 14px;border-radius:3px;margin-bottom:14px;font-size:13px;display:flex;align-items:center;gap:8px;}
.alert-success{background:#E8F5E9;border:1px solid #A5D6A7;color:#2E7D32;}
.alert-error{background:#FFEBEE;border:1px solid #FFCDD2;color:#C62828;}
.alert-info{background:#E3F2FD;border:1px solid #90CAF9;color:#1565C0;}
.alert-warning{background:#FFF8E1;border:1px solid #FFE082;color:#E65100;}
/* TOAST */
.toast-box{position:fixed;top:18px;right:18px;z-index:9999;min-width:300px;max-width:440px;}
/* CANDIDATE MATCH CARD */
.match-card{border:1px solid #BDD0F0;background:#FAFCFF;padding:16px;border-radius:4px;margin-bottom:14px;display:flex;justify-content:space-between;gap:16px;}
.match-left{flex:1;}
.match-title{font-size:15px;font-weight:bold;color:var(--navy);display:flex;align-items:center;gap:8px;}
.match-score-badge{background:#138808;color:#fff;padding:3px 10px;border-radius:12px;font-weight:bold;font-size:12px;}
.match-sub{font-size:12px;color:var(--muted);margin:4px 0 8px;}
.match-desc{font-size:12.5px;color:#333;line-height:1.5;margin-bottom:10px;}
.match-meta{font-size:11.5px;color:#555;margin-bottom:8px;}
.match-right{display:flex;flex-direction:column;justify-content:center;align-items:flex-end;gap:8px;min-width:200px;}
/* MILESTONE CARD */
.ms-box{border:1px solid var(--border);border-radius:3px;margin-bottom:12px;}
.ms-header{background:#F7F9FA;padding:10px 14px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);}
.ms-body{padding:14px;}
.ms-amt{font-size:17px;font-weight:bold;color:var(--navy);}
/* AUDIT BLOCK */
.audit-row{border-left:3px solid #003366;padding:10px 14px;background:#fff;margin-bottom:8px;border-radius:0 3px 3px 0;box-shadow:0 1px 2px rgba(0,0,0,.05);}
.audit-header{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:4px;}
.audit-hash{font-family:monospace;font-size:11px;color:#003366;background:#EEF4FF;padding:2px 6px;border-radius:3px;}
.audit-action{font-weight:bold;color:#212121;font-size:13px;}
/* MODAL */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:6000;align-items:center;justify-content:center;}
.modal-overlay.show{display:flex;}
.modal-box{background:#fff;border-radius:4px;width:100%;max-width:650px;max-height:90vh;overflow-y:auto;box-shadow:0 10px 35px rgba(0,0,0,.25);}
.modal-hdr{background:var(--navy);color:#fff;padding:12px 16px;display:flex;justify-content:space-between;align-items:center;}
.modal-body{padding:20px;}
.modal-close{background:none;border:none;color:#fff;font-size:20px;cursor:pointer;}
.divider{border:none;border-top:1px solid var(--border);margin:14px 0;}
.empty-state{text-align:center;padding:35px 20px;color:var(--muted);}
.spin{display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}
/* TABS */
.tabs{display:flex;border-bottom:2px solid var(--mid);margin-bottom:18px;}
.tab{padding:8px 18px;font-size:13px;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;color:var(--muted);}
.tab.active{border-bottom-color:var(--navy);color:var(--navy);font-weight:bold;}
.tab-content{display:none;}.tab-content.active{display:block;}
.sec-title{font-size:15px;font-weight:bold;color:var(--navy);border-bottom:2px solid var(--navy);padding-bottom:6px;margin-bottom:14px;}
.breadcrumb{font-size:12px;color:var(--muted);margin-bottom:14px;}
.breadcrumb span{cursor:pointer;color:var(--blue);}
/* ROLE GRID */
.role-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:580px;margin:0 auto 24px;}
.role-card{background:#fff;border:2px solid var(--border);border-radius:4px;padding:26px 20px;text-align:center;cursor:pointer;transition:border-color .2s,box-shadow .2s;}
.role-card:hover{border-color:var(--blue);box-shadow:0 3px 12px rgba(0,102,204,.15);}
.role-icon{font-size:36px;margin-bottom:10px;}
.role-title{font-size:15px;font-weight:bold;color:var(--navy);}
.role-desc{font-size:12px;color:var(--muted);margin-top:5px;}
/* LOGIN WRAP */
.login-wrap{min-height:calc(100vh - 150px);display:flex;align-items:center;justify-content:center;padding:20px;}
.login-box{background:#fff;border:1px solid var(--border);width:100%;max-width:420px;box-shadow:0 2px 10px rgba(0,0,0,.1);border-radius:3px;}
.login-hdr{background:var(--navy);color:#fff;padding:14px 20px;text-align:center;}
.login-hdr h2{font-size:15px;}
.login-hdr p{font-size:12px;color:#aac4ff;margin-top:3px;}
.login-body{padding:22px;}
/* FOOTER */
.gov-footer{background:var(--navy);color:#aac4ff;padding:16px;text-align:center;font-size:11px;margin-top:auto;}
@media(max-width:700px){.form-row{grid-template-columns:1fr;}.role-grid{grid-template-columns:1fr;}.match-card{flex-direction:column;}}
</style>
</head>
<body>

<!-- TOP STRIP -->
<div class="top-strip">
  <span>&#x1F1EE;&#x1F1F3; Government of India &nbsp;|&nbsp; Public Procurement Innovation Cell &nbsp;|&nbsp; GFR 2017 Rule 173 Govt Trial Portal</span>
