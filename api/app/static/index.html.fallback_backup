<script>
// ============================================================
// STATE
// ============================================================
let S = {
  token: localStorage.getItem('setu_token'),
  user: null,
  currentChallengeId: null,
  currentPilotId: null,
};
try { S.user = JSON.parse(localStorage.getItem('setu_user') || 'null'); } catch(e) { S.user = null; }

function fmt(n) {
  if (n == null) return '0.00';
  return Number(n).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2});
}
function badge(status) {
  const cls = (status||'').toLowerCase().replace(/\s+/g,'');
  return `<span class="badge badge-${cls}">${status||'Unknown'}</span>`;
}

// ============================================================
// API
// ============================================================
async function api(method, endpoint, body=null) {
  const hdrs = {'Content-Type':'application/json'};
  if (S.token) hdrs['Authorization'] = `Bearer ${S.token}`;
  const opts = {method, headers:hdrs};
  if (body) opts.body = JSON.stringify(body);
  const res = await fetch(`/api/v1${endpoint}`, opts);
  let data;
  try { data = await res.json(); } catch(e) { data = {detail: 'Server error'}; }
  if (!res.ok) {
    if (res.status === 401 && endpoint !== '/auth/login') {
      logout();
      throw new Error('Session expired. Please login again.');
    }
    throw new Error(data.detail || `HTTP ${res.status}`);
  }
  return data;
}

function toast(msg, type='success') {
  const box = document.getElementById('toast-box');
  const el = document.createElement('div');
  el.className = `alert alert-${type}`;
  el.style.cssText = 'box-shadow:0 3px 12px rgba(0,0,0,.2);margin-bottom:8px;';
  el.innerHTML = `${type==='success'?'&#10004;':type==='error'?'&#10008;':'&#8505;'} ${msg}`;
  box.appendChild(el);
  setTimeout(()=>el.remove(), 4500);
}

function showPage(id) {
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  const pg = document.getElementById(id);
  if (pg) pg.classList.add('active');
  window.scrollTo(0,0);
}

// ============================================================
// NAVIGATION
// ============================================================
function navTo(dest) {
  if (!S.user) { showPage('page-landing'); return; }
  const role = S.user.role;
  switch(dest) {
    case 'home':
      if (role==='buyer') loadBuyerHome();
      else if (role==='seller') loadSellerHome();
      else if (role==='admin') loadAdmin();
      break;
    case 'buyer-post': showPage('page-buyer-post'); break;
    case 'buyer-challenges': loadBuyerChallenges(); break;
    case 'buyer-pilots': loadBuyerPilots(); break;
    case 'gem-search': showPage('page-gem-search'); loadCurrentSandboxPool(); break;
    case 'pool':
      if (role === 'buyer') {
        loadBuyerHome().then(() => {
          const el = document.getElementById('dashboard-sandbox-pool-card');
          if (el) el.scrollIntoView({behavior:'smooth'});
        });
      } else {
        showPage('page-gem-search');
        loadCurrentSandboxPool();
      }
      break;
    case 'audit-ledger': loadAuditLedger(); break;
    case 'seller-pilots': loadSellerHome(); break;
    case 'seller-profile': loadSellerProfile(); break;
    case 'admin': loadAdmin(); break;
    default: break;
  }
}

function updateHeaderAndNav() {
  if (!S.user) {
    document.getElementById('main-nav').style.display = 'none';
    document.getElementById('header-user-info').innerHTML = '';
    return;
  }
  document.getElementById('main-nav').style.display = 'flex';
  document.getElementById('header-user-info').innerHTML =
    `${S.user.full_name}<br><small style="color:#aac4ff">${S.user.org_name} &bull; ${S.user.role.toUpperCase()}</small>`;
  document.getElementById('nav-user-info').innerHTML =
    `&#128100; ${S.user.full_name} (${S.user.role})`;
  document.getElementById('nav-buyer').style.display = S.user.role==='buyer'?'flex':'none';
  document.getElementById('nav-seller').style.display = S.user.role==='seller'?'flex':'none';
  document.getElementById('nav-admin').style.display = S.user.role==='admin'?'flex':'none';
}

// ============================================================
// AUTHENTICATION
// ============================================================
let _loginRole = 'buyer';
function showLoginPage(role) {
  _loginRole = role || 'buyer';
  const titles = {buyer:'Govt Officer / Buyer Login', seller:'Supplier / Seller Login', admin:'Administrator Login'};
  document.getElementById('login-title').textContent = titles[role] || 'Login';
  document.getElementById('login-email').value = '';
  document.getElementById('login-password').value = '';
  document.getElementById('login-error').innerHTML = '';
  showPage('page-login');
}

async function doLogin() {
  const email = document.getElementById('login-email').value.trim();
  const pass = document.getElementById('login-password').value;
  if (!email || !pass) {
    document.getElementById('login-error').innerHTML = '<div class="alert alert-error">Please enter username/email and password.</div>';
    return;
  }
  try {
    const data = await api('POST', '/auth/login', {email, password:pass});
    S.token = data.access_token;
    S.user = {id:data.user_id, email:data.email, full_name:data.full_name, role:data.role, org_name:data.org_name};
    localStorage.setItem('setu_token', S.token);
    localStorage.setItem('setu_user', JSON.stringify(S.user));
    updateHeaderAndNav();
    toast(`Authenticated as ${data.full_name}!`);
    navTo('home');
  } catch(e) {
    document.getElementById('login-error').innerHTML = `<div class="alert alert-error">${e.message}</div>`;
  }
}

function logout() {
  S.token = null; S.user = null;
  localStorage.removeItem('setu_token'); localStorage.removeItem('setu_user');
  updateHeaderAndNav();
  showPage('page-landing');
  toast('Logged out successfully.', 'info');
}

// ============================================================
// BUYER WORKFLOWS
// ============================================================
async function loadBuyerHome() {
  showPage('page-buyer-home');
  document.getElementById('buyer-welcome').textContent = `Public Buyer Sandbox &mdash; ${S.user.full_name} (${S.user.org_name})`;
  try {
    const challenges = await api('GET', '/challenges/mine');
    const pilots = await api('GET', '/pilots/mine');
    const matched = challenges.filter(c=>c.status==='Matched'||c.status==='PilotActive').length;
    const activePilots = pilots.filter(p=>p.status==='Active').length;
    const scaleUp = pilots.filter(p=>p.status==='ScaleUpRecommended').length;
    const sellers = await api('GET', '/sellers');

    document.getElementById('buyer-stats').innerHTML = `
      <div class="stat-card"><div class="stat-n">${challenges.length}</div><div class="stat-l">Govt Needs Posted</div></div>
      <div class="stat-card"><div class="stat-n">${matched}</div><div class="stat-l">Suppliers Matched</div></div>
      <div class="stat-card" style="cursor:pointer;" onclick="navTo('pool')"><div class="stat-n" style="color:#004C97;">${sellers.length}</div><div class="stat-l">&#128737; Verified Suppliers in Pool</div></div>
      <div class="stat-card"><div class="stat-n">${activePilots}</div><div class="stat-l">Live Field Trials</div></div>
      <div class="stat-card"><div class="stat-n">${scaleUp}</div><div class="stat-l">Trials Passed (GeM Ready)</div></div>
    `;

    renderChallengesTable(challenges);
    renderDashboardPool(sellers, challenges);
  } catch(e) { toast(e.message, 'error'); }
}

function renderDashboardPool(sellers, challenges) {
  const container = document.getElementById('buyer-dash-pool-list');
  const countEl = document.getElementById('buyer-dash-pool-count');
  if (countEl) countEl.textContent = sellers.length;
  if (!container) return;

  if (!sellers.length) {
    container.innerHTML = `
      <div class="empty-state">
        No suppliers in the sandbox evaluation pool yet.
        <br><button class="btn btn-primary btn-sm" style="margin-top:8px;" onclick="navTo('gem-search')">&#128269; Search &amp; Import GeM Sellers &rarr;</button>
      </div>`;
    return;
  }

  const openChallenge = challenges.find(c => c.status === 'Open' || c.status === 'Matched');

  container.innerHTML = sellers.map(s => `
    <div style="border:1px solid #E2E8F0;background:#F8FAFC;padding:12px 16px;border-radius:4px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;gap:14px;">
      <div style="flex:1;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;flex-wrap:wrap;">
          <strong style="font-size:14px;color:var(--navy);">${s.name}</strong>
          <span class="chip chip-green">&#10004; GeM Verified</span>
          <span class="chip chip-purple">${s.gem_seller_id || 'DPIIT Registered'}</span>
          <span class="chip">TRL ${s.trl_level || 7}/9</span>
          <span class="chip chip-purple">${s.state || 'India'}</span>
        </div>
        <div style="font-size:12.5px;color:var(--muted);margin-bottom:3px;">
          <strong>Solution:</strong> ${s.solution_title || s.domain}
        </div>
        <p style="font-size:12px;color:#444;margin:0;line-height:1.4;">${s.description || ''}</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end;flex-shrink:0;">
        <span class="chip chip-green" style="font-weight:bold;">Qualified for Sandbox</span>
        ${openChallenge ? `
          <button class="btn btn-outline btn-xs" onclick="viewChallenge(${openChallenge.id})">
            &#9889; AI Match in Challenge #${openChallenge.id}
          </button>
        ` : ''}
      </div>
    </div>
  `).join('');
}

function renderChallengesTable(challenges) {
  const tbody = document.getElementById('buyer-challenges-tbody');
  if (!challenges.length) {
    tbody.innerHTML = `<tr><td colspan="6"><div class="empty-state">No outcome challenges posted yet. <a href="#" onclick="navTo('buyer-post')">Post your first challenge &rarr;</a></div></td></tr>`;
    return;
  }
  tbody.innerHTML = challenges.map(c=>`
    <tr onclick="viewChallenge(${c.id})">
      <td>${c.id}</td>
      <td><strong>${c.title}</strong></td>
      <td>${c.department||'—'}</td>
      <td>₹${fmt(c.budget_ceiling_inr)}</td>
      <td>${badge(c.status)}</td>
      <td>
        <button class="btn btn-outline btn-xs" onclick="event.stopPropagation();viewChallenge(${c.id})">View Sandbox &rarr;</button>
      </td>
    </tr>`).join('');
}

async function loadBuyerChallenges() {
  loadBuyerHome();
}

async function submitChallenge() {
  const title = document.getElementById('ch-title').value.trim();
  const dept = document.getElementById('ch-dept').value.trim();
  const loc = document.getElementById('ch-loc').value.trim();
  const budget = parseFloat(document.getElementById('ch-budget').value);
  const outcome = document.getElementById('ch-outcome').value.trim();
  const cat = document.getElementById('ch-category').value.trim();

  if (!title || !budget || !outcome) {
    document.getElementById('post-challenge-error').innerHTML = '<div class="alert alert-error">Title, budget ceiling, and outcome statement are required.</div>';
    return;
  }

  try {
    const res = await api('POST', '/challenges', {
      title, department:dept, location:loc, budget_ceiling_inr:budget, outcome_statement:outcome, category:cat
    });
    toast('Challenge posted to Sandbox!');
    viewChallenge(res.id);
  } catch(e) {
    document.getElementById('post-challenge-error').innerHTML = `<div class="alert alert-error">${e.message}</div>`;
  }
}

async function viewChallenge(id) {
  S.currentChallengeId = id;
  showPage('page-challenge-detail');
  try {
    const ch = await api('GET', `/challenges/${id}`);
    document.getElementById('ch-detail-header').innerHTML = `${ch.title} &nbsp; ${badge(ch.status)}`;
    document.getElementById('ch-detail-body').innerHTML = `
      <div class="form-row">
        <div><b>Department:</b> ${ch.department||'—'}</div>
        <div><b>Location:</b> ${ch.location||'—'}</div>
        <div><b>Budget Ceiling:</b> <strong>₹${fmt(ch.budget_ceiling_inr)}</strong></div>
        <div><b>Status:</b> ${badge(ch.status)}</div>
      </div>
      <hr class="divider">
      <b>Target Outcome Statement (Evaluation Benchmark):</b>
      <p style="margin-top:6px;color:#333;background:#F9F9F9;padding:10px;border-left:3px solid #003366;">${ch.outcome_statement}</p>
    `;

    // Check if an active pilot exists for this challenge
    const pilots = await api('GET', '/pilots/mine');
    const existing = pilots.find(p=>p.challenge_id===id);
    if (existing) {
      document.getElementById('match-results-container').innerHTML = `
        <div class="alert alert-success">
          &#10004; Sandbox MoU Signed! Active Pilot #${existing.id} is underway with <strong>${existing.seller_name}</strong>.
          <button class="btn btn-primary btn-sm" style="margin-left:12px;" onclick="viewPilot(${existing.id})">Open Active Pilot &rarr;</button>
        </div>`;
      document.getElementById('btn-run-match').style.display = 'none';
    } else {
      document.getElementById('btn-run-match').style.display = 'inline-flex';
      document.getElementById('match-results-container').innerHTML = `
        <div class="empty-state">
          Click <strong>"⚡ Run Explainable AI Match"</strong> to evaluate candidates against this outcome statement.
        </div>`;
    }
  } catch(e) { toast(e.message, 'error'); }
