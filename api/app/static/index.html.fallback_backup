<!-- 4. POST CHALLENGE PAGE -->
<div class="page" id="page-buyer-post">
  <div class="breadcrumb"><span onclick="navTo('home')">Dashboard</span> &rsaquo; + Post Govt Need</div>
  <div class="card">
    <div class="card-header">Step 1: State Your Govt Need or Civic Problem</div>
    <div class="card-body">
      <div id="post-challenge-error"></div>
      <div class="alert alert-info">
        &#9888; <strong>Non-Tender Innovation Trial:</strong> Simply describe the real-world problem you need solved (e.g. automated drain flood warning or drone patrolling). Suppliers will be evaluated on whether their technology works, NOT on lowest price quotes (L1).
      </div>
      <div class="form-group">
        <label class="form-label">Govt Need / Problem Statement *</label>
        <input class="form-control" id="ch-title" placeholder="e.g. Ward 14 Urban Drainage Telemetry">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Department / Ministry</label>
          <input class="form-control" id="ch-dept" placeholder="e.g. Pune Municipal Corporation">
        </div>
        <div class="form-group">
          <label class="form-label">Location (City, State)</label>
          <input class="form-control" id="ch-loc" placeholder="e.g. Pune, Maharashtra">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Budget Ceiling (₹) *</label>
          <input class="form-control" type="number" id="ch-budget" placeholder="e.g. 2500000">
        </div>
        <div class="form-group">
          <label class="form-label">Category / Sector</label>
